APP_NAME=DocsChat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: host port for the app and the public domain used in production (automatic HTTPS)
APP_PORT=8000
DOMAIN=localhost
# Behind a reverse proxy on a shared server, so that plain "docker compose" uses these files:
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml:docker-compose.proxy.yml
# PROXY_BIND_ADDRESS=172.17.0.1

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=docschat
DB_USERNAME=docschat
DB_PASSWORD=secret
# Host port for local database clients (dev only, not exposed in production)
FORWARD_DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must be longer than the longest Horizon supervisor timeout (ingestion: 300s)
REDIS_QUEUE_RETRY_AFTER=330

CACHE_STORE=redis
CACHE_PREFIX=docschat_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=docschat_database_
FORWARD_REDIS_PORT=6379

HORIZON_PREFIX=docschat_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# LLM providers (Laravel AI SDK)
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# DocsChat: "laravel-ai" calls the providers above, "fake" runs locally without an API key
DOCSCHAT_AI_DRIVER=laravel-ai
DOCSCHAT_CHAT_PROVIDER=openai
DOCSCHAT_CHAT_MODEL=gpt-6-luna
DOCSCHAT_REWRITE_MODEL=gpt-6-luna
DOCSCHAT_EMBEDDING_PROVIDER=openai
DOCSCHAT_EMBEDDING_MODEL=text-embedding-3-small
DOCSCHAT_DOCUMENTS_DISK=local
DOCSCHAT_RETRIEVAL_MIN_SIMILARITY=0.3
DOCSCHAT_MAX_ANSWER_TOKENS=400
# Checks questions against the provider's free moderation endpoint
DOCSCHAT_MODERATION_ENABLED=true
# Conversations are deleted this many days after their last message
DOCSCHAT_CONVERSATION_RETENTION_DAYS=30

# Admin panel. An account without a password cannot log in. The demo account is
# read-only and its credentials are shown on the login page. In production, set
# ADMIN_PASSWORD to the output of "php artisan docschat:hash-password", in single
# quotes, because a hash contains "$".
ADMIN_EMAIL=
ADMIN_PASSWORD=
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=demo

# Public demo page. Links without a value are not shown.
DEMO_BOT_KEY=pk_seabreeze_demo
DEMO_REPOSITORY_URL=
DEMO_AUTHOR_URL=
DEMO_AUTHOR_LABEL="Work with me"

# Web server threads. Each streamed answer holds one for its whole duration.
FRANKENPHP_NUM_THREADS=16

# The bot stops calling models once this much has been spent in a day
DAILY_BUDGET_USD=2
# Comma-separated proxy addresses, or "*", when running behind a proxy such as Cloudflare
TRUSTED_PROXIES=

VITE_APP_NAME="${APP_NAME}"
