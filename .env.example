APP_NAME=DocsChat
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Docker: host port for the app and the public domain used in production (automatic HTTPS)
APP_PORT=8000
DOMAIN=localhost

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=docschat
DB_USERNAME=docschat
DB_PASSWORD=secret
# Host port for local database clients (dev only, not exposed in production)
FORWARD_DB_PORT=5432

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
# Must be longer than the longest Horizon supervisor timeout (ingestion: 300s)
REDIS_QUEUE_RETRY_AFTER=330

CACHE_STORE=redis
CACHE_PREFIX=docschat_cache_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_PREFIX=docschat_database_
FORWARD_REDIS_PORT=6379

HORIZON_PREFIX=docschat_horizon:

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# LLM providers (Laravel AI SDK)
AI_DEFAULT_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# DocsChat: "laravel-ai" calls the providers above, "fake" runs locally without an API key
DOCSCHAT_AI_DRIVER=laravel-ai
DOCSCHAT_CHAT_PROVIDER=openai
DOCSCHAT_CHAT_MODEL=gpt-6-luna
DOCSCHAT_CHAT_TIMEOUT=30
DOCSCHAT_EMBEDDING_PROVIDER=openai
DOCSCHAT_EMBEDDING_MODEL=text-embedding-3-small
DOCSCHAT_EMBEDDING_DIMENSIONS=1536
DOCSCHAT_EMBEDDING_BATCH_SIZE=100
DOCSCHAT_EMBEDDING_TIMEOUT=60

# Ingestion
DOCSCHAT_DOCUMENTS_DISK=local
DOCSCHAT_PDF_TIMEOUT=60
DOCSCHAT_CRAWLER_USER_AGENT=DocsChatBot/1.0
DOCSCHAT_CRAWLER_CONNECT_TIMEOUT=5
DOCSCHAT_CRAWLER_TIMEOUT=20
DOCSCHAT_CRAWLER_MAX_BYTES=5242880
DOCSCHAT_CHUNK_TARGET_TOKENS=600
DOCSCHAT_CHUNK_OVERLAP_TOKENS=80

VITE_APP_NAME="${APP_NAME}"
