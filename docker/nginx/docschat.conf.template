# Site for an nginx that already owns ports 80 and 443 on the server.
# Replace docschat.example.com, and 172.17.0.1:8000 if PROXY_BIND_ADDRESS or APP_PORT differ.
#
# The upstream is a literal address on purpose: nginx resolves a hostname when it starts and
# refuses to start if that fails, so a stopped DocsChat would take every other site down with it.

server {
    listen 80;
    listen [::]:80;
    server_name docschat.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name docschat.example.com;

    ssl_certificate /etc/letsencrypt/live/docschat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/docschat.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # The admin panel accepts 25 MB documents.
    client_max_body_size 26m;

    location / {
        proxy_pass http://172.17.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Set, not appended: rate limits count this address, so visitors must not choose it.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Port $server_port;
        proxy_set_header X-Forwarded-Prefix "";

        # Answers stream token by token.
        proxy_buffering off;
        proxy_read_timeout 120s;
    }
}
