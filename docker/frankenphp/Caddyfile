{
	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:16}
	}
	admin localhost:2019
	metrics
}

{$SERVER_NAME::80} {
	root * /app/public
	encode zstd br gzip

	log {
		output stdout
		format console
		level {$CADDY_LOG_LEVEL:WARN}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000"
	}

	# A question is 500 characters at most, so the API never needs the upload limit.
	# The front controller answers on its own path too, so that spelling needs the limit as well.
	@api path /api/* /index.php/api/*
	request_body @api {
		max_size 16KB
	}

	handle_errors 413 {
		header Content-Type application/json
		respond `{"message":"The request is too large."}` 413
	}

	@static path /build/* /favicon.ico /robots.txt
	header @static Cache-Control "public, max-age=31536000, immutable"
	header /widget.js Cache-Control "public, max-age=3600"

	php_server {
		try_files {path} index.php
	}
}
